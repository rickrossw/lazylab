{
  "name": "lazylab",
  "version": "0.1.0",
  "private": true,
  "description": "LazyLab: learn GPU cluster architecture, operations, optimization, monitoring and security by playing with a simulated cluster.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "bash scripts/deploy-pages.sh",
    "i18n:extract": "tsx scripts/i18n/extract.ts",
    "i18n:translate": "bash scripts/i18n/translate.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
