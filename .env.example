# Optional sign-in (Supabase). Copy to .env.local and fill in; `npm run deploy` picks it up.
# Both values are public by design: row-level security in supabase/migrations protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Social sign-in buttons to show (enable each provider in Supabase first). Leave empty for email only.
NEXT_PUBLIC_AUTH_PROVIDERS=
